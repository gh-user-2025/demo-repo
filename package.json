{
  "name": "project-management-system",
  "version": "1.0.0",
  "description": "Web-based Project Management System for project planning, tracking, and collaboration",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "client": "cd client && npm start",
    "server": "nodemon server/index.js",
    "install-all": "npm install && cd client && npm install",
    "build": "cd client && npm run build",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [
    "project-management",
    "task-tracking",
    "collaboration",
    "gantt-chart"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
